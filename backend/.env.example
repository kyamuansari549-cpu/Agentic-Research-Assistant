# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# STRONGLY RECOMMENDED: DuckDuckGo's free search frequently rate-limits or
# blocks requests (a known, widely-reported issue, not specific to this
# project). Get a free Tavily key (1000 searches/month, no card needed) at
# https://tavily.com and this app will use it instead of DDG automatically.
TAVILY_API_KEY=

# Model to use for all agents (fast + free-tier friendly)
# Note: llama-3.3-70b-versatile was deprecated by Groq (June 2026) -- using
# their recommended replacement instead. If this ever stops working, check
# https://console.groq.com/docs/models for the current model list.
GROQ_MODEL=openai/gpt-oss-20b

# Max number of critic -> revise loops before forcing a final report
MAX_REVISION_CYCLES=2

# Max sub-tasks the planner is allowed to create
MAX_SUBTASKS=5

# --- Google login (Sign in with Google) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly: <BACKEND_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random long string used to sign JWTs -- generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Where users land after logging in (your frontend's URL)
FRONTEND_URL=http://localhost:5173

# This server's own public URL (used to build the Google redirect_uri)
BACKEND_URL=http://localhost:8000

# --- LLM fallback: Groq (primary) -> Gemini (on 429) ---
# When Groq rate-limits, the failed agent step automatically retries on
# Gemini instead of waiting ~60s. Uses the SAME Google AI Studio key as
# embeddings (NOT the OAuth client id/secret above). Get one free at
# https://aistudio.google.com/apikey -- if unset, the app keeps the old
# Groq-only retry behavior.
GOOGLE_API_KEY=
# Override only if this model ever stops working; check
# https://ai.google.dev/models for the current flash model.
GEMINI_MODEL=gemini-2.5-flash
# Set false to disable the Gemini fallback entirely.
LLM_FALLBACK_ENABLED=true

# --- Database (Supabase Postgres) ---
# Get this from Supabase: Project Settings -> Database -> Connection string
# (use the "Connection pooling" URI, port 6543) -- fill in your DB password.
# Without this, report history won't survive a Render redeploy.
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
